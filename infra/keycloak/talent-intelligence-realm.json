{
  "realm": "talent-intelligence",
  "displayName": "Talent Intelligence",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "loginTheme": "talent-intelligence",
  "accessTokenLifespan": 300,
  "defaultGroups": ["/candidates"],
  "roles": {
    "realm": [
      { "name": "candidate", "description": "Discover public jobs and create personal match decisions" },
      { "name": "recruiter", "description": "Evaluate candidate-to-job matches" },
      { "name": "admin", "description": "Manage the tenant job catalog" }
    ]
  },
  "groups": [
    {
      "name": "candidates",
      "path": "/candidates",
      "realmRoles": ["candidate"]
    }
  ],
  "clients": [
    {
      "clientId": "talent-intelligence-api",
      "name": "Talent Intelligence API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "talent-intelligence-web",
      "name": "Talent Intelligence Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "talent-intelligence-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "talent-intelligence-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant-identity",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "talent-intelligence-smoke",
      "name": "Talent Intelligence Local Smoke Tests",
      "description": "Local-only direct grant client for deterministic Docker verification",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "talent-intelligence-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "talent-intelligence-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant-identity",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "candidate.synthetic",
      "email": "candidate@example.test",
      "firstName": "Synthetic",
      "lastName": "Candidate",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "candidate-local-only", "temporary": false }
      ],
      "realmRoles": ["candidate"]
    },
    {
      "username": "recruiter.synthetic",
      "email": "recruiter@example.test",
      "firstName": "Synthetic",
      "lastName": "Recruiter",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "tenant_id": ["00000000-0000-0000-0000-000000000001"] },
      "credentials": [
        { "type": "password", "value": "recruiter-local-only", "temporary": false }
      ],
      "realmRoles": ["recruiter"]
    },
    {
      "username": "admin.synthetic",
      "email": "admin@example.test",
      "firstName": "Synthetic",
      "lastName": "Administrator",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "tenant_id": ["00000000-0000-0000-0000-000000000001"] },
      "credentials": [
        { "type": "password", "value": "admin-local-only", "temporary": false }
      ],
      "realmRoles": ["admin"]
    }
  ]
}
